{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Bump the pins on shane/workflows from the forge's own tags",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Workflows called from shane/workflows",
      "managerFilePatterns": [
        "/(^|/)\\.forgejo/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "uses: (?:https://git\\.shaneplunkett\\.com/)?(?<depName>shane/workflows)/\\S+@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "forgejo-tags",
      "registryUrlTemplate": "https://git.shaneplunkett.com"
    }
  ],
  "packageRules": [
    {
      "description": "The custom manager reads shane/workflows from the forge's tags. github-actions would look the short form up on github.com, where shane is someone else.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "shane/workflows",
        "https://git.shaneplunkett.com/shane/workflows"
      ],
      "enabled": false
    },
    {
      "description": "actions/checkout v5 and later keep the job's credentials where git on the host runner can't read them, so fetching from the forge fails",
      "matchPackageNames": [
        "actions/checkout"
      ],
      "allowedVersions": "<5"
    }
  ]
}
